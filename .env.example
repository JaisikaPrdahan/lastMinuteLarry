# ---- Required ------------------------------------------------------------
# Neon Postgres connection string (Vercel > Storage > Neon sets this for you)
DATABASE_URL=

# The one password that unlocks the app. Use a long passphrase.
APP_PASSWORD=

# Random 32+ character string used to sign the login cookie.
# Generate everything below with:  npm run keys
SESSION_SECRET=

# ---- Photos/PPT/PDF uploads ----------------------------------------------
# Vercel > Storage > Blob sets this automatically when you connect a store.
BLOB_READ_WRITE_TOKEN=
# Only set this if your Blob store can't be private (files then get unguessable but public URLs)
# NEXT_PUBLIC_BLOB_ACCESS=public

# ---- Push notifications ---------------------------------------------------
# npm run keys prints these two.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any contact address, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/reminders (Vercel sends it automatically as a Bearer token)
CRON_SECRET=

# ---- Optional -------------------------------------------------------------
# Timezone used for "today", week boundaries and reminder times
APP_TZ=Asia/Kolkata
